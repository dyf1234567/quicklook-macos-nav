+    private string GetAdjacentFile(string currentPath, int direction)
+    {
+        try
+        {
+            var dir = Path.GetDirectoryName(currentPath);
+            if (string.IsNullOrEmpty(dir) || !Directory.Exists(dir))
+                return null;
+
+            var files = Directory.GetFiles(dir)
+                .Where(f =>
+                {
+                    try
+                    {
+                        var attrs = File.GetAttributes(f);
+                        return (attrs & (FileAttributes.Hidden | FileAttributes.System)) == 0;
+                    }
+                    catch
+                    {
+                        return false;
+                    }
+                })
+                .OrderBy(f => f, StringComparer.CurrentCultureIgnoreCase)
+                .ToList();
+
+            var index = files.IndexOf(currentPath);
+            if (index < 0)
+                return null;
+
+            var next = index + direction;
+            return next >= 0 && next < files.Count ? files[next] : null;
+        }
+        catch (Exception e)
+        {
+            Debug.WriteLine(e);
+            return null;
+        }
+    }
