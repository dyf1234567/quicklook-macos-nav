+<Project>
+  <!--
+    Local build helper:
+    1) Provides .NET Framework reference assemblies for building net4xx targets
+       without installing the Developer Pack / Visual Studio.
+    2) Pins C# language version so generated XAML temporary projects still
+       compile `?.=` (null-conditional assignment) etc.
+    3) Enables preserialized resources (needed by WPF/net462 builds).
+  -->
+  <PropertyGroup>
+    <LangVersion>preview</LangVersion>
+    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
+  </PropertyGroup>
+  <ItemGroup>
+    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
+    <PackageReference Include="System.Resources.Extensions" Version="7.0.0" PrivateAssets="all" />
+  </ItemGroup>
+</Project>
